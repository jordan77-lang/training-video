# Environment Configuration Example
# Copy this file to .env for local development

# Optional: OpenAI API Key for advanced AI summarization
# OPENAI_API_KEY=your_api_key_here

# Optional: Maximum file upload size in bytes (default: 10MB)
# MAX_UPLOAD_SIZE=10485760

# Optional: Maximum number of slides that can be generated (default: 10)
# MAX_SLIDES=10

# Optional: Default slide count when not specified by user
# DEFAULT_SLIDE_COUNT=5
